node_modules/
frontend/dist/

# ── Generated output files ─────────────────────────────────────────────────
backend/address_label.png
backend/tickets_out/
*.png.bak

# ── User config (contains saved printer address, settings, etc.) ───────────
backend/config.json

# ── OS / IDE ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

