/**
 * Global reactive store built on @preact/signals.
 * Every piece of UI state lives here — components just read/write signals.
 */

import { signal, computed } from "@preact/signals";
import type { Device, TabId, SourceKind } from "../types";

// ─── devices ───────────────────────────────────────────────────────────

export const devices = signal<Device[]>([]);
export const isScanning = signal(false);
export const selectedDevice = signal<Device | null>(null);
export const isConnected = signal(false);
export const connectionStatus = signal<"idle" | "connecting" | "connected" | "error">("idle");

// ─── print settings (client-side, sent to backend before each print) ──

export const processMode = signal<"picture" | "pattern" | "text">("picture");
export const brightness = signal(128);
export const energy = signal(64);
export const quality = signal(36);
export const rotate = signal(false);
export const rotate180 = signal(false);
export const transparentAsWhite = signal(true);

// ─── app settings ──────────────────────────────────────────────────────

export const scanTime = signal(5);
export const dryRun = signal(false);
export const flipH = signal(false);
export const flipV = signal(false);

// ─── derived: CSS filter to simulate thermal energy on the preview ─────

/**
 * Maps energy (0-256) to CSS brightness + contrast, mimicking how thermal
 * strength affects the physical print. Same formula as the original Cat-Printer.
 * Higher energy = darker/more contrast print.
 */
export const energyCssFilter = computed(() => {
  const rate = energy.value / 256;
  const bright = Math.max(1.6 - rate * 1.5, 0.75);
  const contrast = 1 + rate * 2;
  return `brightness(${bright}) contrast(${contrast})`;
});

// ─── UI state ──────────────────────────────────────────────────────────

export const activeTab = signal<TabId>("print");
export const theme = signal<"light" | "dark">("light");

// ─── source content ────────────────────────────────────────────────────

export const sourceKind = signal<SourceKind>("none");
export const sourceImage = signal<HTMLImageElement | null>(null);
export const sourceFile = signal<File | null>(null); // for pdf / badge

// ─── transient UI state ────────────────────────────────────────────────

export const isPrinting = signal(false);
export const statusMessage = signal("");
export const showTextModal = signal(false);

// ─── derived ───────────────────────────────────────────────────────────

export const canPrint = computed(
  () => sourceKind.value !== "none" && !isPrinting.value,
);
